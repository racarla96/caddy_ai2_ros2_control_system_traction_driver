<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="system_traction">
  <xacro:arg name="prefix" default="" />

  <!-- Import RRBot ros2_control description -->
  <xacro:include filename="$(find caddy_ai2_ros2_control_system_traction_driver)/description/ros2_control/system_traction.ros2_control.xacro" />

  <!-- Used for fixing robot -->
<!-- Used for fixing robot -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
  </link>

  <joint name="system_traction_joint" type="revolute">
    <parent link="base_link"/>
    <child link="system_traction_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="1000" velocity="1000" lower="-3.14" upper="3.14"/>
  </joint>

  <link name="system_traction_link">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.05"/>
      </geometry>
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
  </link>

  <xacro:system_traction_ros2_control update_rate="$(arg update_rate)"/>

</robot>
